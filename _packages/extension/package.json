{
    "name": "vscode-finclang",
    "description": "The extension specific package",
    "version": "0.0.1",
    "displayName": "finclang",
    "type": "module",
    "engines": {
        "vscode": "^1.91.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [{
            "id": "finclang",
            "aliases": ["finclang", "finclang"],
            "extensions": [".fncl"],
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "finclang",
            "scopeName": "source.finclang",
            "path": "syntaxes/finclang.tmLanguage.json"
        }]
    },
    "activationEvents": [
        "onLanguage:finclang"
    ],
    "main": "./out/extension/main.cjs",
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out syntaxes",
        "vscode:prepublish": "npm run build",
        "build:prepare": "shx mkdir -p ./syntaxes/ && shx cp -f ../language/syntaxes/finclang.tmLanguage.json ./syntaxes/finclang.tmLanguage.json",
        "build": "npm run build:prepare && tsc -b tsconfig.json && node esbuild.mjs",
        "build:clean": "npm run clean && npm run build",
        "watch": "npm run build:prepare && concurrently -n tsc,esbuild -c blue,yellow \"tsc -b tsconfig.json --watch\" \"node esbuild.mjs --watch\""
    },
    "dependencies": {
        "finclang-language": "0.0.1",
        "vscode-languageclient": "~10.0.1",
        "vscode-languageserver": "~10.0.1"
    },
    "devDependencies": {
        "@types/vscode": "~1.91.0",
        "concurrently": "~10.0.3",
        "esbuild": "~0.28.1"
    },
    "vsce": {
      "dependencies": false
    }
}
