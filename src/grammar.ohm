DataGrammar {
  // 1. Entry point with the optional leading date
  Transaction = DateTime? FromCycleBlock "->" ToCycleBlock restOfLine
  
  // 2. The loop repeats zero or more times, checking for "TR" first
  FromCycleBlock = (~"->" fromCycleItem)*
  ToCycleBlock = (~"\"" toCycleItem)*
  
  // 3. The repeating core: string, optional string, double
  fromCycleItem = string optionalString fromDouble
  toCycleItem = string optionalString toDouble
  
  // --- Primitive Rule Definitions ---
  
  // Syntactic rules (capitalized) automatically skip spaces
  DateTime       = Date Time?
  Date           = digit digit "/" digit digit "/" digit digit digit digit
  Time           = digit digit ":" digit digit ":"? digit? digit?
  
  // Lexical rules (lowercase) do not skip spaces internally
  string         = (letter|":")+
  optionalString = letter*   // Matches 0 or more letters safely
  fromDouble     = (digit|".")+ digit*
  toDouble       = (digit|".")* digit*
  
  restOfLine     = any*
}